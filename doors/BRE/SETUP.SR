2   <- Line # of Username or First name
0   <- Line # of Last name (0 if prev line was full name)
0   <- Line # of IBM charaters (1/Y/G = yes)
14   <- Line # of ANSI support (1/Y/G/C = yes)
10   <- Line # of number of lines on the screen
20   <- Line # of baud rate
21   <- Line # of COM port
0   <- Line # of time left (minutes)
3   <- Line # of Real Name
Enter 0 for any value not supported.
