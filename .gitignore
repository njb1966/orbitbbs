# Disk images — large binary files, not suitable for git
*.qcow2
*.img

# Build artifacts (DOS object files, compiled EXEs built by BCC)
wwivs424/obj/
wwivs424/exe/BBS.SYM

# Borland C++ 3.1 toolchain — large, binary, reproducible
BCPP31/

# Temp directories
TEMP/
os/
memory/

# tcpser compiled objects (source stays, objects don't)
tcpser/src/*.o

# Build artifacts and map files
wwivs424/BBS.MAP
wwivs424/BUILD.LOG
wwivs424/&1

# Fetched feed content (regenerated by cron)
feeds/

# Logs
*.log
