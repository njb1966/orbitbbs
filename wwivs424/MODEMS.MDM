###############################################################################
#"MicroCom V.Fast ES series" 2/7/95
# Configuration of MicroCom Deskporte V.Fast 28.8K BPS modem by Cable
# Added result codes, such as Locked to show the modem port was locked
# in the result logs. If 16800 BPS or higher the V.Fast was added
# You might want to tweak the INIT string a bit, some crappy old 9600 or
# 14400 baud modems don't like Flow control, which the MicroCom V.Fast
# can turn off with the &K0 command, &K3 gives RTS/CTS, &K6 does both.
# If you have a locked port, you need some sort of flow control, or else
# your users or yourself will see garbage. \G0 disables modem port flow
# control and \G1 uses X-on / X-Off Flow control for your port.
# 1995 Update solves some connection problems with %E2 and &Q5 commands.
#

FILE: "MCVFES"
NAME: "Microcom ES Series"
NOTE: "MicroCom 28800"
SETU: "AT&F&C1&D2E0M0W1X4S0=0S2=1s37=0%e2%c1&k3&Q5V1S11=50S95=44&w1{"
INIT: "ATZ1{"
ANSR: "ATA{"
PICK: "ATH1{"
HANG: "ATH0{"
DIAL: "ATDT"
SEPR: ""
DEFL: MS=28800 CS=57600 EC=Y DC=Y AS=N FC=Y
RESL: "OK"                     "Normal"               NORM
RESL: "CONNECT"                "CONNECTED"            CON
RESL: "RING"                   "Ring"                 RING
RESL: "NO CARRIER"             "No Carrier"           DIS
RESL: "ERROR"                  "ERROR"                ERR
RESL: "NO DIALTONE"            "No Dial Tone"         NDT
RESL: "BUSY"                   "Busy"                 DIS
RESL: "NO ANSWER"              "No Answer"            DIS
RESL: "RINGING"                "Ringing"              RINGING
RESL: "VOICE"                  "Voice"                DIS
RESL: "CARRIER 300"            "300"                  MS=300
RESL: "CARRIER 600"            "600"                  MS=600
RESL: "CARRIER 1200"           "1200"                 MS=1200
RESL: "CARRIER 2400"           "2400"                 MS=2400
RESL: "CARRIER 4800"           "4800"                 MS=4800
RESL: "CARRIER 7200"           "7200"                 MS=7200
RESL: "CARRIER 9600"           "9600"                 MS=9600
RESL: "CARRIER 12000"          "12000"                MS=12000
RESL: "CARRIER 14400"          "14400"                MS=14400
RESL: "CARRIER 16800"          "16800/V.Fast"         MS=16800
RESL: "CARRIER 19200"          "19200/V.Fast"         MS=19200
RESL: "CARRIER 21700"          "21700/V.Fast"         MS=21700
