##########################################################################
# BocaModem V.34 FAX/MODEM
# by Sir Real (max baker) 1@15072.wwivnet
#                         1@5058.icenet
#                         1@15058.wwivlink
# I have an external BOCA, so it may not work completley well for an internal
# I am having a problem with 28800 reporting as RING, but all other speeds
# report correctly.    If you can figure out the problem, or use this file,
# please mail me (for no good reason but that fuzzy feeling knowing someone
# is using this stupid thing =] )
#-------------------------------------------------------------------------
# Your stored profile #1 will be overwritten with the command strings.
# I have the port locked to 57.6, so all connects should be at 57.6.
# It will report if connected at another speed, because that's considered
# a problem, so if you run a faster or slower speed, change accordingly the
# connect lines to from '/C38' to '' and change the CS strings in DEFL & FAX
#

FILE: "BOCA34"
NAME: "Boca Modem V.34 FAX/MODEM"
CONF: "AT&F&D2X4W1S7=70S0=0S6=2S95=60S11=50s37=15&C1{~~AT%C3%E2\\G0&K3M0&W1{"
INIT: "ATH0&D2Z1S37=15M0{"
ANSR: "ATA{"
PICK: "ATH1M0{"
HANG: "ATH0{"
DIAL: "ATDT"
DEFL: MS=28800 CS=57600 EC=N DC=N AS=N FC=Y
RESL: "OK"                     "Normal"               NORM
RESL: "RING"                   "Ring"                 RING
RESL: "NO CARRIER"             "No Carrier"           DIS
RESL: "ERROR"                  "ERROR"                ERR
RESL: "NO DIALTONE"            "No Dial Tone"         NDT
RESL: "BUSY"                   "Busy"                 DIS
