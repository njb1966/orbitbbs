RESL: "CARRIER 26400"          "26400/V.Fast"         MS=26400
RESL: "CARRIER 21600"          "24000/V.Fast"         MS=21600
RESL: "CARRIER 28800"          "28800/V.Fast"         MS=28800
RESL: "PROTOCOL: V.42/LAPM"    '/LAPM'                EC=Y
RESL: "PROTOCOL: LAP-M"        '/LAPM'                EC=Y
