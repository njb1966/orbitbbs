###############################################################################
#
# ATI 2400/etc/e
#

FILE: "ATI2400"
NAME: "ATI 2400ETC/E or 2400ETC/I"
CONF: "AT&F2&C1&D2H0E0V0W2X6S11=55S7=75S38=255&W0&Y0{"
INIT: "ATZ{"
SETU: ""
ANSR: "ATA{"
PICK: "ATH1{"
HANG: "ATH0{"
DIAL: "ATDT"
SEPR: ""
DEFL: MS=9600 CS=9600 EC=N DC=N AS=N FC=Y
RESL: "0"    "OK"            NORM
RESL: "2"    "Ring"          RING
RESL: "1"    "300"           CON MS=300
RESL: "3"    "No Carrier"    DIS
RESL: "4"    "Error"         ERR
RESL: "5"    "1200"          CON MS=1200
RESL: "6"    "No Dial Tone"  NDT
RESL: "7"    "Busy"          DIS
RESL: "8"    "No Answer"     DIS
RESL: "18"   "Ringing"       RINGING
RESL: "19"   "Voice"         DIS
RESL: "10"   "2400"          CON MS=2400
RESL: "11"   "4800"          CON MS=4800
RESL: "12"   "9600"          CON MS=9600
RESL: "20"   "300/MNP"       CON MS=300  EC=Y DC=Y
RESL: "22"   "1200/MNP"      CON MS=1200 EC=Y DC=Y
RESL: "23"   "2400/MNP"      CON MS=2400 EC=Y DC=Y
RESL: "24"   "1200/LAPM"     CON MS=1200 EC=Y DC=Y
RESL: "25"   "2400/LAPM"     CON MS=2400 EC=Y DC=Y


